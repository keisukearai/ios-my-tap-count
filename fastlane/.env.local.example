# 実値は書かないこと。このファイルをコピーして fastlane/.env.local を作る。
# .env.local は .gitignore 済み。
#
#   cp fastlane/.env.local.example fastlane/.env.local
#
# App Store Connect API キー（Users and Access > Integrations > App Store Connect API）
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=

# Apple ID / Team
APPLE_ID=
TEAM_ID=HFZSU3MJLR

# 審査担当者への連絡先（upload_metadata で送る）
REVIEW_PHONE=
REVIEW_EMAIL=
