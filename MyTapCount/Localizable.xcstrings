    "guide.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app earns its keep once the widget is on your Home Screen. It takes a minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはウィジェットを置いてはじめて価値が出ます。1分で終わります。"
          }
        }
      }
    },
    "guide.navTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget setup guide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェット設置ガイド"
          }
        }
      }
    },
    "guide.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons start to jiggle — that is edit mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンが揺れる編集モードに入ります。"
          }
        }
      }
    },
    "guide.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold the Home Screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面を長押しする"
          }
        }
      }
    },
    "guide.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget gallery opens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットギャラリーが開きます。"
          }
        }
      }
    },
    "guide.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top left"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上の ＋ を押す"
          }
        }
      }
    },
    "guide.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small shows one counter big; medium stacks three or four."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "small は1項目を大きく、medium は3〜4項目を並べます。"
          }
        }
      }
    },
    "guide.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick MyTapCount, then a size"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MyTapCount を選び、サイズを選ぶ"
          }
        }
      }
    },
    "guide.step4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the placed widget → Edit Widget → pick the counter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置いたウィジェットを長押し →「ウィジェットを編集」→ 項目を選びます。"
          }
        }
      }
    },
    "guide.step4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For small, choose which counter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "small は表示する項目を選ぶ"
          }
        }
      }
    },
    "guide.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget setup guide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェット設置ガイド"
          }
        }
      }
