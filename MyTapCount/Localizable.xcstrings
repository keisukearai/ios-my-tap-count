    "detail.swipeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a record left to delete it — this is how you undo a mistaken widget tap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を左にスワイプすると削除できます（ウィジェットの誤タップはここで直します）。"
          }
        }
      }
    },
