    "home.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add something you want to count — water, medication, push-ups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「水」「薬」など、数えたいことを追加してください。"
          }
        }
      }
    },
    "home.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No counters yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウンターがありません"
          }
        }
      }
    },
    "home.foot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This order is the order shown in the widget. Long-press a row to edit or delete it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並び順はウィジェットの表示順と同じです。行を長押しすると編集・削除ができます。"
          }
        }
      }
    },
    "home.guideCta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
